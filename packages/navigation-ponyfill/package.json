{
  "name": "navigation-ponyfill",
  "version": "0.0.0",
  "description": "A ponyfill (polyfill) for the browser Navigation API",
  "keywords": [
    "navigation",
    "navigation-api",
    "ponyfill",
    "polyfill",
    "history",
    "router"
  ],
  "license": "MIT",
  "author": {
    "name": "Kevin Crawford",
    "url": "https://kcrwfrd.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kcrwfrd/navigation-ponyfill.git",
    "directory": "packages/navigation-ponyfill"
  },
  "bugs": {
    "url": "https://github.com/kcrwfrd/navigation-ponyfill/issues"
  },
  "homepage": "https://github.com/kcrwfrd/navigation-ponyfill",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
