{
  "name": "root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:lib": "npm run dev --workspace=packages/navigation-ponyfill",
    "dev:next": "npm run dev --workspace=examples/next",
    "build": "npm run build --workspace=packages/navigation-ponyfill",
    "build:next": "npm run build --workspace=examples/next",
    "clean": "npm run clean --workspace=packages/navigation-ponyfill",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build && changeset publish",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "npm run test --workspace=packages/navigation-ponyfill",
    "test:watch": "npm run test:watch --workspace=packages/navigation-ponyfill",
    "test:coverage": "npm run test:coverage --workspace=packages/navigation-ponyfill",
    "test:types": "npm run test:types --workspace=packages/navigation-ponyfill",
    "test:e2e": "npm run test:e2e --workspace=examples/next"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "prettier": "^3.6.2"
  }
}
